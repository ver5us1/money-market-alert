DATABASE_URL=postgresql://money_market_alert:replace_me@127.0.0.1:5432/money_market_alert
FINNHUB_API_KEY=replace_me
BOT_TOKEN=replace_me

# Ollama stays on localhost unless a private remote endpoint is configured.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

RUN_INTERVAL_SECONDS=900
NEWS_DAYS_BACK=2
NEWS_REQUEST_DELAY_SECONDS=2
MAX_NEWS_TO_ANALYZE=5
MAX_ALERTS_TO_SEND=10
TELEGRAM_SEND_DELAY_SECONDS=1
LOG_LEVEL=INFO
